{
    "compilerOptions": {
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "alwaysStrict": true,
        "lib": ["dom", "dom.iterable", "es2023"],
        "experimentalDecorators": true,
        "moduleResolution": "node",
        "noImplicitAny": true,
        "noImplicitOverride": true,
        "noPropertyAccessFromIndexSignature": true,
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "declarationDir": "build",
        "target": "es2023"
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}
